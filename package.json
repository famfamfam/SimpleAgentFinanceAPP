{
  "name": "financeapp",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --config frontend/vite.config.js",
    "build": "vite build --config frontend/vite.config.js",
    "format": "prettier --write \"frontend/src/**/*.{js,jsx,css}\" frontend/vite.config.js",
    "format:check": "prettier --check \"frontend/src/**/*.{js,jsx,css}\" frontend/vite.config.js",
    "test": "node --test tests/model.test.js tests/model-currency.test.js tests/i18n.test.js",
    "test:e2e": "playwright test",
    "i18n:audit": "node scripts/i18n-audit.mjs",
    "i18n:check": "node scripts/i18n-audit.mjs --check",
    "test:all": "npm run test && npm run test:e2e"
  },
  "devDependencies": {
    "@playwright/test": "1.58.2",
    "@vitejs/plugin-react": "^6.2.1",
    "prettier": "3.9.10",
    "vite": "^8.3.5"
  },
  "dependencies": {
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  }
}
