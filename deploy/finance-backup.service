[Unit]
Description=Finance database and configuration backup
After=docker.service
Requires=docker.service

[Service]
Type=oneshot
WorkingDirectory=/opt/finance
ExecStart=/bin/sh /opt/finance/scripts/backup.sh
UMask=0077
Nice=19
IOSchedulingClass=idle
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths=/opt/finance/backups
